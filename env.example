NODE_ENV=production

HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/nexapoint
DIRECT_URL=postgresql://user:password@localhost:5432/nexapoint

AUTH_SESSION_SECRET=change-me-to-a-long-random-secret-key
AUTH_SESSION_COOKIE=nexa_session
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_ONLY=false
LOG_LEVEL=info

NEXA_STORAGE_ROOT=.data/storage

SMS_PROVIDER=mock
SMS_IR_API_KEY=
SMS_IR_TEMPLATE_ID=

OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SEND_PER_PHONE_PER_DAY=10

# Runflare: پس از اولین migrate موفق برای ری‌استارت سریع‌تر true کنید
SKIP_MIGRATE=false
SKIP_BOOTSTRAP=false
MIGRATE_ONLY=false

NEXT_PUBLIC_CRM_FAUX=false
MEIZITO_WORKSPACE_STORAGE=db
MEIZITO_COMMS_STORAGE=db
