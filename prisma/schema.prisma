}

model LetterCategoryConfig {
  id         String   @id @default(cuid())
  businessId String
  slug       String
  labelFa    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
  @@index([businessId])
}

model PhoneDirectoryGroup {
  id         String   @id @default(cuid())
  businessId String
  name       String
  slug       String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries  PhoneDirectoryEntry[]

  @@unique([businessId, slug])
  @@index([businessId])
}

model PhoneDirectoryEntry {
  id             String                  @id @default(cuid())
  businessId     String
  groupId        String?
  entryKind      PhoneDirectoryEntryKind @default(internal)
  visibilityTags Json                    @default("[]")
  displayName    String
  firstName      String                  @default("")
  lastName       String                  @default("")
  mobile         String                  @default("")
  landline       String                  @default("")
  internalCode   String                  @default("")
  address        String                  @default("")
  notes          String                  @default("")
  extension      String                  @default("")
  department     String                  @default("")
  jobTitle       String                  @default("")
  userId         String?
  personId       String?
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group    PhoneDirectoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  person   Person?              @relation(fields: [businessId, personId], references: [businessId, personId], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, department])
  @@index([groupId])
}

// ---------------------------------------------------------------------------
// 9. HR, Org, Attendance, Payroll & Training
// ---------------------------------------------------------------------------

model HrRequestType {
  id         String   @id @default(cuid())
  businessId String
  slug       String
  labelFa    String
  kind       String   @default("hr")
  formSchema Json     @default("{}")
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  eligibilityRules HrEligibilityRule[]

  @@unique([businessId, slug])
  @@index([businessId])
}

model HrEligibilityRule {
  id            String   @id @default(cuid())
  businessId    String
  requestTypeId String?
  hrSubtype     String?
  conditionJson Json
  userMessageFa String
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestType HrRequestType? @relation(fields: [requestTypeId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, hrSubtype])
}

model OrgUnit {
  id         String   @id @default(cuid())
  businessId String
  name       String
  parentId   String?
  phone      String   @default("")
  email      String   @default("")
  location   String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignments OrgAssignment[]

  @@index([businessId])
}

model OrgAssignment {
  id            String   @id @default(cuid())
  businessId    String
  unitId        String
  userId        String
  managerUserId String?
  roleTitle     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  unit     OrgUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId, unitId])
}

model PersonnelFile {
  id             String   @id @default(cuid())
  businessId     String
  userId         String
  formTemplateId String?
  payload        Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId])
}

model AttendanceLog {
  id              String           @id @default(cuid())
  businessId      String
  userId          String?
  employeeName    String
  workDate        DateTime?        @db.Date
  checkIn         String           @default("")
  checkOut        String           @default("")
  workedMinutes   Int              @default(0)
  overtimeMinutes Int              @default(0)
  status          AttendanceStatus @default(present)
  note            String           @default("")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, workDate])
}

model PayrollPeriodSummary {
  id           String   @id @default(cuid())
  businessId   String
  userId       String?
  employeeName String
  periodLabel  String
  baseSalary   Decimal  @default(0) @db.Decimal(20, 0)
  overtimePay  Decimal  @default(0) @db.Decimal(20, 0)
  bonuses      Decimal  @default(0) @db.Decimal(20, 0)
  deductions   Decimal  @default(0) @db.Decimal(20, 0)
  netPay       Decimal  @default(0) @db.Decimal(20, 0)
  status       String   @default("در انتظار پرداخت")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, periodLabel])
}

model TrainingCourse {
  id            String   @id @default(cuid())
  businessId    String
  title         String
  instructor    String   @default("")
  category      String   @default("عمومی")
  durationHours Int      @default(0)
  startDate     String   @default("")
  capacity      Int      @default(20)
  status        String   @default("فعال")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enrollments TrainingEnrollment[]

  @@index([businessId])
}

model TrainingEnrollment {
  id              String   @id @default(cuid())
  courseId        String
  userId          String?
  participantName String
  progressPercent Int      @default(0)
  score           Decimal? @db.Decimal(18, 6)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// ---------------------------------------------------------------------------
// 10. Marketing, Sales Network & After-Sales
// ---------------------------------------------------------------------------

model MarketingCampaign {
  id               String         @id @default(cuid())
  businessId       String
  name             String
  channel          String         @default("اینستاگرام")
  budget           Decimal        @default(0) @db.Decimal(20, 0)
  spent            Decimal        @default(0) @db.Decimal(20, 0)
  leadsCount       Int            @default(0)
  conversionsCount Int            @default(0)
  startDate        String         @default("")
  endDate          String         @default("")
  status           CampaignStatus @default(active)
  notes            String         @default("")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model MarketingSurvey {
  id            String   @id @default(cuid())
  businessId    String
  title         String
  description   String   @default("")
  status        String   @default("فعال")
  questionsJson Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business  Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([businessId])
}

model SurveyResponse {
  id              String   @id @default(cuid())
  surveyId        String
  respondentName  String   @default("")
  respondentPhone String   @default("")
  score           Int      @default(5)
  comment         String   @default("")
  createdAt       DateTime @default(now())

  survey MarketingSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model SalesNetworkMember {
  id             String   @id @default(cuid())
  businessId     String
  code           String   @default("")
  fullName       String
  phone          String   @default("")
  region         String   @default("")
  tier           String   @default("نماینده")
  personId       String?
  userId         String?
  commissionRate Decimal  @default(5) @db.Decimal(18, 6)
  totalSales     Decimal  @default(0) @db.Decimal(20, 0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  person      Person?           @relation(fields: [businessId, personId], references: [businessId, personId], onDelete: SetNull)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  commissions SalesCommission[]

  @@index([businessId])
}

model SalesCommission {
  id               String   @id @default(cuid())
  businessId       String
  memberId         String
  periodLabel      String
  salesAmount      Decimal  @default(0) @db.Decimal(20, 0)
  commissionAmount Decimal  @default(0) @db.Decimal(20, 0)
  status           String   @default("در انتظار تسویه")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  member   SalesNetworkMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([businessId, memberId])
}

model WarrantyRecord {
  id           String         @id @default(cuid())
  businessId   String
  warrantyNo   String
  customerName String
  productName  String
  serialNumber String         @default("")
  startDate    String         @default("")
  endDate      String         @default("")
  status       WarrantyStatus @default(active)
  notes        String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tickets  AfterSalesTicket[]

  @@index([businessId, status])
}

model AfterSalesTicket {
  id           String         @id @default(cuid())
  businessId   String
  warrantyId   String?
  ticketNo     String
  customerName String
  phone        String         @default("")
  productName  String         @default("")
  subject      String
  description  String         @default("")
  priority     TicketPriority @default(normal)
  status       TicketStatus   @default(open)
  technician   String         @default("")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  business  Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warranty  WarrantyRecord? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  estimates RepairEstimate[]

  @@index([businessId, status])
}

model RepairEstimate {
  id                 String   @id @default(cuid())
  ticketId           String
  laborCost          Decimal  @default(0) @db.Decimal(20, 0)
  partsCost          Decimal  @default(0) @db.Decimal(20, 0)
  totalCost          Decimal  @default(0) @db.Decimal(20, 0)
  approvedByCustomer Boolean  @default(false)
  notes              String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ticket AfterSalesTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// 11. Automation, Workflows & Inquiries
// ---------------------------------------------------------------------------

model AutomationRule {
  id             String    @id @default(cuid())
  businessId     String
  name           String
  description    String    @default("")
  trigger        String
  conditionsJson Json      @default("[]")
  actionsJson    Json      @default("[]")
  active         Boolean   @default(true)
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  logs     AutomationLog[]

  @@index([businessId, active])
}

model AutomationLog {
  id         String   @id @default(cuid())
  businessId String
  ruleId     String?
  ruleName   String   @default("")
  trigger    String   @default("")
  status     String   @default("success")
  summary    String   @default("")
  payload    Json     @default("{}")
  executedAt DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rule     AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([businessId, executedAt])
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  module      String   @default("عمومی")
  description String   @default("")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  steps    WorkflowStep[]
  runs     WorkflowRun[]

  @@index([businessId])
}

model WorkflowStep {
  id              String @id @default(cuid())
  workflowId      String
  stepOrder       Int    @default(1)
  title           String
  approverRoleKey String @default("manager")
  slaHours        Int    @default(24)

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, stepOrder])
}

model WorkflowRun {
  id               String            @id @default(cuid())
  businessId       String
  workflowId       String
  title            String            @default("")
  entityType       String            @default("general")
  entityId         String            @default("")
  currentStepOrder Int               @default(1)
  status           WorkflowRunStatus @default(running)
  initiatedBy      String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model InquiryRecord {
  id             String        @id @default(cuid())
  businessId     String
  inquiryNo      String
  subject        String
  requesterName  String
  requesterPhone String        @default("")
  source         String        @default("تلفن")
  category       String        @default("استعلام قیمت")
  estimatedValue Decimal       @default(0) @db.Decimal(20, 0)
  assignedTo     String        @default("")
  status         InquiryStatus @default(new)
  responseNote   String        @default("")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

// ---------------------------------------------------------------------------
// 12. Public Store & Blog (Fully Normalized)
// ---------------------------------------------------------------------------

model StoreSettings {
  businessId     String   @id
  shopName       String   @default("فروشگاه نکسا")
  currency       String   @default("تومان")
  shippingNote   String   @default("")
  seoTitle       String   @default("")
  seoDescription String   @default("")
  seoKeywords    String   @default("")
  isPublished    Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model StoreProduct {
  id               String   @id @default(cuid())
  businessId       String
  catalogProductId String?
  name             String
  category         String   @default("عمومی")
  priceNum         Decimal  @default(0) @db.Decimal(20, 0)
  stockQty         Int      @default(0)
  seo              String   @default("")
  description      String   @default("")
  imageKey         String?
  featured         Boolean  @default(false)
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  catalogProduct CatalogProduct?   @relation(fields: [businessId, catalogProductId], references: [businessId, productId], onDelete: SetNull)
  orderItems     StoreOrderItem[]

  @@unique([businessId, catalogProductId])
  @@index([businessId, status])
}

model StoreOrder {
  id              String   @id @default(cuid())
  businessId      String
  orderNo         String   @default("")
  customer        String
  customerPhone   String   @default("")
  shippingAddress String   @default("")
  date            DateTime? @db.Date
  totalNum        Decimal  @default(0) @db.Decimal(20, 0)
  status          StoreOrderStatus @default(pending_processing)
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    StoreOrderItem[]

  @@index([businessId, status])
  @@index([businessId, date])
}

model StoreOrderItem {
  id             String  @id @default(cuid())
  orderId        String
  storeProductId String?
  title          String
  quantity       Int     @default(1)
  unitPrice      Decimal @default(0) @db.Decimal(20, 0)
  lineTotal      Decimal @default(0) @db.Decimal(20, 0)

  order        StoreOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeProduct StoreProduct? @relation(fields: [storeProductId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model BlogSettings {
  businessId     String   @id
  seoTitle       String   @default("بلاگ نکساپوینت")
  seoDescription String   @default("")
  isPublished    Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BlogCategory {
  id         String   @id @default(cuid())
  businessId String
  name       String
  slug       String
  count      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  posts    BlogPost[]

  @@unique([businessId, slug])
  @@index([businessId])
}

model BlogPost {
  id            String        @id @default(cuid())
  businessId    String
  categoryId    String?
  title         String
  slug          String        @default("")
  excerpt       String        @default("")
  content       String        @default("")
  coverImageKey String?
  author        String        @default("")
  date          DateTime?     @db.Date
  views         Int           @default(0)
  publishState  PublishStatus @default(published)
  categoryName  String        @default("عمومی")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments BlogComment[]

  @@index([businessId, publishState])
}

model BlogComment {
  id        String   @id @default(cuid())
  businessId String
  postId    String?
  user      String
  email     String   @default("")
  text      String
  date      DateTime? @db.Date
  postTitle String   @default("")
  status    String   @default("در انتظار تایید")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  post     BlogPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model NewsletterSubscriber {
  id         String   @id @default(cuid())
  businessId String
  email      String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([businessId])
}
