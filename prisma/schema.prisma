generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  disabled
  pending
}

enum AccessRequestStatus {
  pending
  approved
  rejected
}

enum BusinessPlan {
  trial
  active
}

enum BusinessStatus {
  active
  archived
}

enum BusinessMemberRole {
  owner
  admin
  member
}

enum MoneyDocumentKind {
  receipt
  payment
}

enum CommerceDocumentKind {
  sale
  sale_return
  purchase
  purchase_return
  expense
  waste
  income
}

enum PhoneDirectoryEntryKind {
  internal
  linked_user
  linked_person
}

enum WarehouseVoucherType {
  issue
  transfer
  receipt
}

enum FormulaRowKind {
  material
  direct_labor
  overhead
}

enum BankTransactionType {
  deposit
  withdrawal
  transfer_in
  transfer_out
  fee
}

enum CheckDirection {
  receivable
  payable
}

enum CheckStatus {
  pending
  cleared
  bounced
  endorsed
  cancelled
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum JournalStatus {
  draft
  posted
  cancelled
}

enum AttendanceStatus {
  present
  absent
  leave
  remote
  late
}

enum CampaignStatus {
  draft
  active
  paused
  completed
}

enum TicketPriority {
  low
  normal
  high
  critical
}

enum TicketStatus {
  open
  diagnosing
  waiting_part
  repairing
  resolved
  closed
}

enum WarrantyStatus {
  active
  expired
  void
}

enum WorkflowRunStatus {
  running
  approved
  rejected
  completed
}

enum InquiryStatus {
  new
  in_review
  quoted
  closed
}

enum PublishStatus {
  draft
  published
  archived
}

// ---------------------------------------------------------------------------
// 1. Identity, Auth & RBAC
// ---------------------------------------------------------------------------

model SystemRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameFa      String
  level       Int
  permissions Json
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id                 String     @id @default(cuid())
  username           String     @unique
  mobilePhone        String?    @unique
  passwordHash       String?
  displayName        String
  status             UserStatus @default(active)
  systemRoleId       String
  mustChangePassword Boolean    @default(false)
  avatarFileKey      String?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  systemRole        SystemRole       @relation(fields: [systemRoleId], references: [id])
  sessions          Session[]
  businessesCreated Business[]       @relation("BusinessCreatedBy")
  businessMembers   BusinessMember[]
  invitesCreated    UserInvite[]     @relation("InviteCreatedBy")
  accessReviews     AccessRequest[]  @relation("AccessReviewedBy")
  restriction       UserRestriction?
  bankAccess        UserBankAccess[]
  attachments       Attachment[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpChallenge {
  id           String    @id @default(cuid())
  mobilePhone  String
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  consumedAt   DateTime?
  ip           String?
  createdAt    DateTime  @default(now())

  @@index([mobilePhone, createdAt])
  @@index([expiresAt])
}

model UserInvite {
  id                 String    @id @default(cuid())
  roleSlug           String
  tokenHash          String    @unique
  displayName        String?
  mobilePhone        String?
  credentialMode     String    @default("self")
  presetUsername     String?
  presetPasswordHash String?
  expiresAt          DateTime
  usedAt             DateTime?
  createdById        String
  createdAt          DateTime  @default(now())

  createdBy User @relation("InviteCreatedBy", fields: [createdById], references: [id])

  @@index([expiresAt])
}

model AccessRequest {
  id           String              @id @default(cuid())
  mobilePhone  String
  displayName  String?
  status       AccessRequestStatus @default(pending)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  reviewedBy User? @relation("AccessReviewedBy", fields: [reviewedById], references: [id])

  @@index([mobilePhone, status])
  @@index([status])
}

model UserRestriction {
  userId            String  @id
  ownSalesOnly      Boolean @default(false)
  ownPurchaseOnly   Boolean @default(false)
  timeWindowEnabled Boolean @default(false)
  allowedFrom       String?
  allowedTo         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBankAccess {
  id       String  @id @default(cuid())
  userId   String
  bankCode String
  allowed  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bankCode])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// 2. Multi-Tenant Business & Settings
// ---------------------------------------------------------------------------

model Business {
  id            String         @id @default(cuid())
  name          String
  plan          BusinessPlan   @default(trial)
  expiresAt     DateTime?
  creditLabel   String         @default("نامحدود")
  defaultLocale String         @default("fa")
  status        BusinessStatus @default(active)
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  createdBy User @relation("BusinessCreatedBy", fields: [createdById], references: [id])

  members     BusinessMember[]
  profile     BusinessProfile?
  fiscalYears FiscalYear[]
  projects    BusinessProject[]
  attachments Attachment[]

  // Settings
  exchangeRates     ExchangeRate[]
  formTemplates     FormTemplate[]
  notificationRules NotificationRule[]
  picklistItems     PicklistItem[]

  // People & Catalog
  people          Person[]
  peopleMeta      BusinessPeopleMeta?
  moneyDocuments  MoneyDocument[]
  shareholders    ShareholderRecord[]
  vendors         VendorRecord[]
  catalogProducts CatalogProduct[]
  catalogMeta     BusinessCatalogMeta?

  // CRM
  crmLeads          CrmLead[]
  crmVisits         CrmVisit[]
  crmClubMembers    CrmClubMember[]
  crmPipelineStages CrmPipelineStage[]
  crmOpportunities  CrmOpportunity[]

  // Commerce (Sales & Purchasing)
  commerceDocuments CommerceDocument[]
  commerceMeta      BusinessCommerceMeta?

  // Orders, Procurement, Production & Warehouse (Normalized)
  warehouseLocations  WarehouseLocation[]
  warehouseItems      WarehouseItem[]
  warehouseVouchers   WarehouseVoucher[]
  stocktakingSessions StocktakingSession[]
  customerOrders      CustomerOrder[]
  shippingSchedules   ShippingSchedule[]
  procurementRequests ProcurementRequest[]
  productionFormulas  ProductionFormula[]
  productionOrders    ProductionOrder[]
  workOrders          WorkOrder[]

  // Banking & Accounting
  bankAccounts       BankAccount[]
  cashboxes          Cashbox[]
  pettyCashes        PettyCash[]
  bankTransactions   BankTransaction[]
  fundTransfers      FundTransfer[]
  checks             CheckItem[]
  accountingAccounts AccountingAccount[]
  journalEntries     JournalEntry[]

  // Workspace & Comms
  meizitoWorkspaceMeta  BusinessMeizitoWorkspaceMeta?
  workspaceBoards       WorkspaceBoard[]
  workspaceColumns      WorkspaceColumn[]
  workspaceLabels       WorkspaceLabel[]
  workspaceBoardMembers WorkspaceBoardMember[]
  workspaceCards        WorkspaceCard[]
  workspaceNotes        WorkspaceNote[]
  workspaceDailyReports WorkspaceDailyReport[]
  workspaceFieldVisits  WorkspaceFieldVisit[]
  workspaceProjects     WorkspaceProject[]
  noteBoards            NoteBoard[]
  internalLetters       InternalLetter[]
  meizitoCalendars      MeizitoCalendar[]
  meizitoCalendarEvents MeizitoCalendarEvent[]
  chatThreads           ChatThread[]
  chatMessages          ChatMessage[]
  internalWorkRequests  InternalWorkRequest[]
  meizitoApprovalSteps  MeizitoApprovalStep[]
  letterCategoryConfigs LetterCategoryConfig[]
  phoneDirectoryGroups  PhoneDirectoryGroup[]
  phoneDirectoryEntries PhoneDirectoryEntry[]

  // HR & Org
  hrRequestTypes     HrRequestType[]
  hrEligibilityRules HrEligibilityRule[]
  orgUnits           OrgUnit[]
  orgAssignments     OrgAssignment[]
  personnelFiles     PersonnelFile[]
  attendanceLogs     AttendanceLog[]
  payrollSummaries   PayrollPeriodSummary[]
  trainingCourses    TrainingCourse[]

  // Marketing, Sales Network, After-Sales
  marketingCampaigns MarketingCampaign[]
  marketingSurveys   MarketingSurvey[]
  salesNetworkMembers SalesNetworkMember[]
  salesCommissions   SalesCommission[]
  warrantyRecords    WarrantyRecord[]
  afterSalesTickets  AfterSalesTicket[]

  // Automation, Workflows & Inquiries
  automationRules     AutomationRule[]
  automationLogs      AutomationLog[]
  workflowDefinitions WorkflowDefinition[]
  workflowRuns        WorkflowRun[]
  inquiries           InquiryRecord[]

  // Public Store & Blog (Normalized)
  storeSettings         StoreSettings?
  storeProducts         StoreProduct[]
  storeOrders           StoreOrder[]
  blogSettings          BlogSettings?
  blogCategories        BlogCategory[]
  blogPosts             BlogPost[]
  blogComments          BlogComment[]
  newsletterSubscribers NewsletterSubscriber[]

  @@index([status])
  @@index([createdById])
}

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole @default(member)
  joinedAt   DateTime?
  createdAt  DateTime           @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model BusinessProfile {
  businessId   String   @id
  legalName    String   @default("")
  tradeName    String   @default("")
  nationalId   String   @default("")
  economicCode String   @default("")
  regNo        String   @default("")
  phone        String   @default("")
  fax          String   @default("")
  address      String   @default("")
  postalCode   String   @default("")
  city         String   @default("")
  website      String   @default("")
  email        String   @default("")
  logoFileKey  String?
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model FiscalYear {
  id         String   @id @default(cuid())
  businessId String
  label      String
  startDate  String
  endDate    String
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@index([businessId])
}

model BusinessProject {
  id         String   @id @default(cuid())
  businessId String
  name       String
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model ExchangeRate {
  id           String   @id @default(cuid())
  businessId   String
  code         String
  nameFa       String
  rateToRial   Float    @default(0)
  effectiveAt  String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@index([businessId])
}

model FormTemplate {
  id          String   @id @default(cuid())
  businessId  String
  module      String   @default("general")
  name        String
  description String   @default("")
  fieldsJson  Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, module])
}

model NotificationRule {
  id          String   @id @default(cuid())
  businessId  String
  eventKey    String
  titleFa     String
  inApp       Boolean  @default(true)
  sms         Boolean  @default(false)
  email       Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, eventKey])
  @@index([businessId])
}

model PicklistItem {
  id         String   @id @default(cuid())
  businessId String
  groupKey   String
  code       String   @default("")
  label      String
  color      String   @default("")
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, groupKey])
}

model Attachment {
  id           String   @id @default(cuid())
  businessId   String?
  uploaderId   String?
  entityType   String   @default("general")
  entityId     String?
  fileKey      String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  uploader User?     @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([businessId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// 3. People, Catalog & Money Documents
// ---------------------------------------------------------------------------

model Person {
  businessId     String
  personId       String
  displayName    String   @default("")
  accountingCode String   @default("")
  kind           String   @default("natural")
  status         String   @default("active")
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, personId])
  @@index([businessId])
  @@index([businessId, status])
}

model BusinessPeopleMeta {
  businessId       String   @id
  personCategories Json
  personGroups     Json
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model MoneyDocument {
  id         String            @id @default(cuid())
  businessId String
  kind       MoneyDocumentKind
  docDate    String            @default("")
  totalAmount Float            @default(0)
  data       Json
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, kind])
}

model ShareholderRecord {
  id         String   @id @default(cuid())
  businessId String
  personId   String
  percent    Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, personId])
  @@index([businessId])
}

model VendorRecord {
  id             String   @id @default(cuid())
  businessId     String
  personId       String
  sellPercent    Float    @default(0)
  refundPercent  Float    @default(0)
  expenseAccount String   @default("")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, personId])
  @@index([businessId])
}

model CatalogProduct {
  businessId     String
  productId      String
  name           String   @default("")
  code           String   @default("")
  accountingCode String   @default("")
  type           String   @default("goods")
  status         String   @default("active")
  data           Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, productId])
  @@index([businessId])
  @@index([businessId, status])
}

model BusinessCatalogMeta {
  businessId        String   @id
  productCategories Json
  priceLists        Json
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// 4. CRM
// ---------------------------------------------------------------------------

model CrmLead {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  source         String   @default("")
  interest       String   @default("")
  registeredDate String   @default("")
  status         String   @default("جدید")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model CrmVisit {
  id              String   @id @default(cuid())
  businessId      String
  customerName    String
  phone           String   @default("")
  source          String   @default("")
  companions      Int      @default(0)
  withDesigner    Boolean  @default(false)
  gender          String   @default("female")
  buyProbability  Int      @default(0)
  visitedAt       DateTime @default(now())
  result          String   @default("خنثی")
  designerName    String   @default("")
  durationMinutes Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model CrmPipelineStage {
  id         String   @id @default(cuid())
  businessId String
  title      String
  sortOrder  Int      @default(0)
  color      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  opportunities CrmOpportunity[]

  @@index([businessId])
}

model CrmOpportunity {
  id            String   @id @default(cuid())
  businessId    String
  stageId       String
  title         String
  leadId        String?
  personId      String?
  amount        Float?
  expectedClose String   @default("")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stage    CrmPipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([stageId])
}

model CrmClubMember {
  id         String   @id @default(cuid())
  businessId String
  personId   String?
  name       String
  phone      String   @default("")
  level      String   @default("")
  score      Int      @default(0)
  lastVisit  String   @default("")
  status     String   @default("فعال")
  source     String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

// ---------------------------------------------------------------------------
// 5. Sales & Purchasing (Commerce)
// ---------------------------------------------------------------------------

model CommerceDocument {
  id          String               @id @default(cuid())
  businessId  String
  kind        CommerceDocumentKind
  docDate     String               @default("")
  totalAmount Float                @default(0)
  status      String               @default("confirmed")
  data        Json
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, kind])
}

model BusinessCommerceMeta {
  businessId       String   @id
  incomeTypes      Json
  installments     Json
  productDiscounts Json
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// 6. Warehouse, Orders, Procurement & Production (Fully Normalized)
// ---------------------------------------------------------------------------

model WarehouseLocation {
  id         String   @id @default(cuid())
  businessId String
  code       String
  name       String
  address    String   @default("")
  manager    String   @default("")
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@index([businessId])
}

model WarehouseItem {
  id         String   @id @default(cuid())
  businessId String
  data       Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model WarehouseVoucher {
  id                     String               @id @default(cuid())
  businessId             String
  number                 String
  date                   String               @default("")
  status                 String               @default("ثبت شده")
  description            String               @default("")
  type                   WarehouseVoucherType @default(issue)
  warehouseReceiptStatus String               @default("pending")
  sourceInvoiceNumber    String               @default("")
  sourceWarehouseId      String               @default("")
  destinationWarehouseId String               @default("")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  business Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items    WarehouseVoucherItem[]

  @@index([businessId, type])
}

model WarehouseVoucherItem {
  id           String  @id @default(cuid())
  voucherId    String
  itemCode     String  @default("")
  title        String  @default("")
  requestedQty Float   @default(0)
  availableQty Float   @default(0)
  quantity     Float   @default(0)
  unit         String  @default("عدد")

  voucher WarehouseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([voucherId])
}

model StocktakingSession {
  id          String   @id @default(cuid())
  businessId  String
  number      String
  warehouseId String   @default("")
  date        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rows     StocktakingRow[]

  @@index([businessId])
}

model StocktakingRow {
  id         String @id @default(cuid())
  sessionId  String
  itemCode   String @default("")
  title      String @default("")
  systemQty  Float  @default(0)
  countedQty Float  @default(0)

  session StocktakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model CustomerOrder {
  id         String   @id @default(cuid())
  businessId String
  orderNo    String   @default("")
  customer   String
  items      String   @default("")
  date       String   @default("")
  status     String   @default("در انتظار تایید")
  progress   Int      @default(0)
  type       String   @default("new")
  amount     String   @default("")
  totalRial  Float    @default(0)
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shippingSchedules ShippingSchedule[]

  @@index([businessId, type])
}

model ShippingSchedule {
  id            String   @id @default(cuid())
  businessId    String
  orderId       String?
  orderNo       String   @default("")
  customerName  String   @default("")
  carrierName   String   @default("")
  scheduledDate String   @default("")
  trackingCode  String   @default("")
  status        String   @default("برنامه‌ریزی شده")
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  order    CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

model ProcurementRequest {
  id          String   @id @default(cuid())
  businessId  String
  title       String
  type        String   @default("تأمین کالا")
  requester   String   @default("")
  requesterId String?
  date        String   @default("")
  status      String   @default("در انتظار تایید")
  priority    String   @default("متوسط")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
}

model ProductionFormula {
  id              String   @id @default(cuid())
  businessId      String
  number          String
  date            String   @default("")
  project         String   @default("")
  status          String   @default("confirmed")
  isActive        Boolean  @default(true)
  productItemCode String   @default("")
  outputWarehouse String   @default("")
  description     String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

